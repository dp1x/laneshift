config_version=5

[application]
config/name="LANESHIFT"
config/description="LaneShift arcade driving game and ML experiment platform"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=800
window/size/viewport_height=450
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; The app is DPI-unaware, so Windows shrinks the requested window by the
; display scale (150% here) while leaving the framebuffer at viewport size.
; Requesting 1.5x the canvas makes the physical window match it exactly.
window/size/window_width_override=1200
window/size/window_height_override=675

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
